# Public Git settings shared by every account. Identity, directory includes,
# and credential routing stay in the dotfiles checkout, whose ~/.gitconfig
# includes this file from the installed Nix profile. delta ships in this bundle.
[merge]
    conflictStyle = zdiff3

[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    features = +side-by-side
